# Ghostty — shared alipes terminal settings.
font-size = 12
adjust-cell-height = 1

# Updated by switch-theme.
config-file = themes/everblush.conf

cursor-style = block
cursor-style-blink = true
background-opacity = 1
window-padding-x = 14
window-padding-y = 14
# Use the default window decorations (including Ubuntu's title bar).
confirm-close-surface = false
copy-on-select = clipboard
clipboard-read = deny
clipboard-write = allow

# Start Zsh directly for directory-managed accounts where chsh is unavailable.
command = /usr/bin/zsh

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+h=write_scrollback_file:open
keybind = ctrl+shift+m=toggle_maximize
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_window
keybind = ctrl+equal=increase_font_size:0.5
keybind = ctrl+minus=decrease_font_size:0.5
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+f5=reload_config
